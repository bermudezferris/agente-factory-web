# Server-only Supabase credentials. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta webhook values configured in the Meta App dashboard.
META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-system-user-access-token
META_PHONE_REGISTRATION_PIN=your-six-digit-registration-pin

# Phase 2. OPENAI_API_KEY enables automatic replies; admin routes require ADMIN_API_KEY.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
AGENT_NAME=Valentina (IA)
BOOKING_URL=https://calendar.app.google/fpBQSm3KDvQH3wqF8
ADMIN_API_KEY=generate-a-long-random-value
